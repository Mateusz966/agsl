{
  "name": "agsl",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "serverless offline start -s dev --reloadHandler",
    "generate-migration": "docker-compose up -d && ts-node ./node_modules/typeorm/cli.js migration:generate ./migrations/migration -d ./shared/config/db",
    "run-migrations": "docker-compose up -d && serverless invoke local --function migrations",
    "revert-migration": "docker-compose up -d && ts-node ./node_modules/typeorm/cli.js migration:revert -d ./shared/config/db",
    "create-migration": "docker-compose up -d && ts-node ./node_modules/typeorm/cli.js migration:create ./migrations/migration"
  },
  "dependencies": {
    "@middy/core": "^4.7.0",
    "@middy/http-cors": "^4.7.0",
    "@middy/http-event-normalizer": "^4.7.0",
    "@middy/http-header-normalizer": "^4.7.0",
    "@middy/http-json-body-parser": "^4.7.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "http-status-codes": "^2.3.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^3.2.0",
    "ts-pipe-compose": "^0.2.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.8.1",
    "@types/webpack-env": "^1.18.5",
    "copy-webpack-plugin": "^12.0.2",
    "serverless-esbuild": "^1.54.4",
    "serverless-offline": "^14.3.3",
    "serverless-webpack": "^5.15.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "webpack": "^5.95.0"
  }
}
